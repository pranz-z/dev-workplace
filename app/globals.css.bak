@import url("https://fonts.googleapis.com/css2?family=Caveat:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&display=swap");
@import "tailwindcss";

:root {
  --background: #f6efe6;
  --paper: #fffaf3;
  --paper-strong: #f0e4d2;
  --paper-soft: #f8f1e7;
  --card: rgba(255, 255, 255, 0.7);
  --ink: #2d261f;
  --muted: #72655d;
  --lavender: #e3dcff;
  --blue: #dfeefc;
  --green: #ddf1dd;
  --peach: #f9ddd1;
  --coral: #f7c9bf;
  --yellow: #f9e7b0;
  --pink: #f8dfe8;
  --line: rgba(88, 69, 56, 0.18);
  --shadow: rgba(93, 70, 54, 0.12);
  --surface: rgba(255, 255, 255, 0.7);
  --surface-strong: rgba(255, 255, 255, 0.9);
  --surface-alt: rgba(248, 241, 233, 0.9);
  --page-glow: rgba(247, 201, 191, 0.18);
  --button-text: #2d261f;
  --public-card: rgba(255, 255, 255, 0.68);
  --public-border: rgba(90, 74, 62, 0.18);
}

html[data-theme="dark"] {
  --background: #171514;
  --paper: #201d1a;
  --paper-strong: #2a241f;
  --paper-soft: #1c1a18;
  --card: rgba(38, 34, 31, 0.8);
  --ink: #f4efe9;
  --muted: #c7b8a4;
  --lavender: rgba(141, 124, 184, 0.28);
  --blue: rgba(118, 151, 183, 0.26);
  --green: rgba(119, 158, 126, 0.28);
  --peach: rgba(184, 129, 97, 0.26);
  --coral: rgba(191, 125, 103, 0.24);
  --yellow: rgba(178, 154, 97, 0.26);
  --pink: rgba(181, 130, 156, 0.24);
  --line: rgba(214, 201, 190, 0.14);
  --shadow: rgba(8, 6, 5, 0.34);
  --surface: rgba(34, 30, 27, 0.92);
  --surface-strong: rgba(43, 38, 35, 0.96);
  --surface-alt: rgba(27, 23, 20, 0.96);
  --sidebar: rgba(23, 20, 19, 0.98);
  --header: rgba(29, 25, 24, 0.86);
  --panel: rgba(41, 37, 34, 0.96);
  --panel-strong: rgba(51, 46, 42, 0.98);
  --page-glow: rgba(175, 128, 150, 0.14);
  --button-text: #f7f1ea;
  --public-card: rgba(31, 28, 27, 0.9);
  --public-border: rgba(224, 207, 196, 0.14);
}

html { scroll-behavior: smooth; color-scheme: light; }
html[data-theme="dark"] { color-scheme: dark; }

html[data-theme="dark"] body {
  background:
    radial-gradient(circle at top left, rgba(175, 128, 150, 0.16), transparent 18%),
    radial-gradient(circle at bottom right, rgba(118, 151, 183, 0.14), transparent 24%),
    linear-gradient(180deg, var(--paper-soft) 0%, var(--background) 100%);
}

html[data-theme="dark"] .app-shell::before {
  opacity: 0.18;
  background-image: radial-gradient(rgba(219, 204, 192, 0.08) 0.8px, transparent 0.8px);
}

html[data-theme="dark"] .paper-card,
html[data-theme="dark"] .sticky-note,
html[data-theme="dark"] .note-card {
  background: linear-gradient(180deg, rgba(230, 222, 212, 0.94), rgba(210, 201, 191, 0.96));
  border-color: rgba(98, 82, 70, 0.16);
  box-shadow: 0 12px 20px rgba(0, 0, 0, 0.18), inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

html[data-theme="dark"] .paper-card::before,
html[data-theme="dark"] .sticky-note::before,
html[data-theme="dark"] .note-card::before {
  opacity: 0.6;
}


html[data-theme="dark"] .paper-card h1,
html[data-theme="dark"] .paper-card h2,
html[data-theme="dark"] .paper-card h3 {
  color: #2f2925 !important;
}

html[data-theme="dark"] .ink-button {
  background: rgba(36, 32, 30, 0.96);
  border-color: rgba(220, 210, 201, 0.12);
  color: #f4efe9;
  box-shadow: 0 4px 0 rgba(6, 5, 5, 0.22);
}

html[data-theme="dark"] .ink-button.primary {
  background: rgba(28, 25, 24, 0.96);
  color: #f4efe9;
}

html[data-theme="dark"] .ink-button.soft,
html[data-theme="dark"] .ink-button.coral,
html[data-theme="dark"] .ink-button.green {
  background: rgba(35, 31, 29, 0.92);
  color: #f4efe9;
}

html[data-theme="dark"] .soft-pill,
html[data-theme="dark"] .task-tag {
  background: rgba(48, 42, 39, 0.82);
  border-color: rgba(220, 210, 201, 0.12);
  color: #f4efe9;
}

html[data-theme="dark"] .project-card {
  background: linear-gradient(180deg, rgba(40, 36, 33, 0.96), rgba(29, 26, 24, 0.96));
  border-color: rgba(220, 210, 201, 0.12);
  box-shadow: 0 12px 18px rgba(0, 0, 0, 0.2);
}

html[data-theme="dark"] .project-card p,
html[data-theme="dark"] .project-card h3,
html[data-theme="dark"] .project-card h4,
html[data-theme="dark"] .project-card h2 {
  color: #f0e9e2 !important;
}

html[data-theme="dark"] .project-card .text-muted {
  color: rgba(201, 185, 173, 0.9) !important;
}

html[data-theme="dark"] .pastel-lavender { background: linear-gradient(180deg, rgba(126, 113, 167, 0.28), rgba(38, 34, 39, 0.96)); }
html[data-theme="dark"] .pastel-blue { background: linear-gradient(180deg, rgba(100, 125, 155, 0.26), rgba(31, 36, 40, 0.96)); }
html[data-theme="dark"] .pastel-peach { background: linear-gradient(180deg, rgba(161, 110, 83, 0.24), rgba(42, 33, 30, 0.96)); }
html[data-theme="dark"] .pastel-green { background: linear-gradient(180deg, rgba(100, 128, 102, 0.24), rgba(29, 35, 31, 0.96)); }
html[data-theme="dark"] .pastel-pink { background: linear-gradient(180deg, rgba(147, 110, 136, 0.22), rgba(39, 32, 36, 0.96)); }

html[data-theme="dark"] .bg-slate-900,
html[data-theme="dark"] .bg-slate-950,
html[data-theme="dark"] .bg-slate-950\/70,
html[data-theme="dark"] .bg-slate-900\/80,
html[data-theme="dark"] .bg-slate-800,
html[data-theme="dark"] .bg-slate-700\/80,
html[data-theme="dark"] .bg-slate-700\/70,
html[data-theme="dark"] .bg-slate-900\/90,
html[data-theme="dark"] .bg-slate-950\/80,
html[data-theme="dark"] .bg-slate-950\/60,
html[data-theme="dark"] .bg-slate-950\/50,
html[data-theme="dark"] .bg-slate-950\/40 {
  background-color: rgba(41, 38, 34, 0.96) !important;
}

html[data-theme="dark"] .text-white,
html[data-theme="dark"] .text-slate-100,
html[data-theme="dark"] .text-slate-200,
html[data-theme="dark"] .text-slate-300,
html[data-theme="dark"] .text-slate-400,
html[data-theme="dark"] .text-slate-500,
html[data-theme="dark"] .text-slate-600,
html[data-theme="dark"] .text-slate-700 {
  color: #f3eee7 !important;
}

html[data-theme="dark"] .text-slate-400,
html[data-theme="dark"] .text-slate-500,
html[data-theme="dark"] .text-slate-600,
html[data-theme="dark"] .text-slate-700 {
  color: rgba(200, 186, 173, 0.8) !important;
}

html[data-theme="dark"] .border-white\/10,
html[data-theme="dark"] .border-white\/20,
html[data-theme="dark"] .border-white\/30 {
  border-color: rgba(216, 203, 192, 0.12) !important;
}

html[data-theme="dark"] .bg-emerald-500 {
  background: rgba(120, 155, 128, 0.9) !important;
  color: #f5efe9 !important;
}

html[data-theme="dark"] .bg-emerald-500\/10,
html[data-theme="dark"] .bg-emerald-500\/20 {
  background: rgba(120, 155, 128, 0.18) !important;
}

html[data-theme="dark"] .border-emerald-500\/30 {
  border-color: rgba(120, 155, 128, 0.35) !important;
}

html[data-theme="dark"] .bg-white\/55,
html[data-theme="dark"] .bg-white\/40,
html[data-theme="dark"] .bg-white\/45 {
  background: rgba(35, 31, 29, 0.83) !important;
}

html[data-theme="dark"] .bg-gradient-hero {
  background: linear-gradient(135deg, rgba(133, 110, 154, 0.55), rgba(156, 130, 110, 0.68)) !important;
}

@theme inline {
  --color-background: var(--background);
  --color-foreground: var(--ink);
  --font-sans: var(--font-geist-sans);
  --font-mono: var(--font-geist-mono);
}

html {
  scroll-behavior: smooth;
}

body {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(249, 223, 232, 0.55), transparent 24%),
    radial-gradient(circle at bottom right, rgba(223, 238, 252, 0.6), transparent 26%),
    linear-gradient(180deg, var(--paper-soft) 0%, var(--background) 100%);
  color: var(--ink);
  font-family: "Manrope", Arial, Helvetica, sans-serif;
  transition: background-color 220ms ease, color 220ms ease;
}

* {
  box-sizing: border-box;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

::selection {
  background: rgba(163, 140, 255, 0.3);
}

.app-shell {
  position: relative;
  background-image: linear-gradient(rgba(104, 91, 82, 0.03) 1px, transparent 1px),
    linear-gradient(90deg, rgba(104, 91, 82, 0.02) 1px, transparent 1px);
  background-size: 26px 26px;
}

.app-shell::before {
  content: "";
  position: fixed;
  inset: 0;
  background-image: radial-gradient(rgba(116, 99, 89, 0.08) 0.7px, transparent 0.7px);
  background-size: 18px 18px;
  pointer-events: none;
  opacity: 0.35;
}

.paper-card {
  position: relative;
  background: rgba(255, 255, 255, 0.58);
  border: 2px solid rgba(91, 73, 62, 0.18);
  border-radius: 28px;
  box-shadow: 0 8px 0 rgba(84, 68, 60, 0.08), 0 20px 40px rgba(93, 70, 54, 0.08);
  overflow: hidden;
}

.paper-card::before {
  content: "";
  position: absolute;
  width: 18px;
  height: 18px;
  right: 18px;
  top: 16px;
  background: rgba(137, 108, 91, 0.08);
  border-radius: 9999px;
  transform: rotate(18deg);
}

.sticky-note {
  position: relative;
  background: linear-gradient(180deg, rgba(255, 255, 255, 0.72), rgba(249, 236, 217, 0.82));
  border: 2px solid rgba(112, 90, 77, 0.2);
  border-radius: 22px;
  box-shadow: 0 6px 14px rgba(117, 93, 77, 0.08);
  transform: rotate(var(--tilt, 0deg));
}

.doodle-divider {
  position: relative;
  height: 0;
  border-top: 2px dashed rgba(120, 93, 83, 0.28);
  margin: 18px 0;
}

.doodle-divider::before,
.doodle-divider::after {
  content: "";
  position: absolute;
  width: 11px;
  height: 11px;
  border-radius: 50%;
  background: rgba(154, 132, 116, 0.15);
  top: -6px;
}

.doodle-divider::before { left: 10%; }
.doodle-divider::after { right: 12%; }

.section-title {
  font-family: "Caveat", cursive;
  letter-spacing: 0.05em;
  font-weight: 700;
  color: var(--ink);
}

.soft-pill {
  border: 1.5px solid rgba(90, 74, 62, 0.18);
  background: rgba(255, 255, 255, 0.48);
  color: var(--ink);
  border-radius: 9999px;
  box-shadow: inset 0 1px 0 rgba(255,255,255,0.65);
}

.project-card {
  position: relative;
  border-radius: 24px;
  border: 2px solid rgba(94, 72, 62, 0.18);
  background: linear-gradient(180deg, rgba(255,255,255,0.72), rgba(255,255,255,0.55));
  box-shadow: 0 10px 18px rgba(78, 63, 55, 0.08);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.project-card:hover {
  transform: translateY(-2px) rotate(-0.3deg);
  box-shadow: 0 14px 22px rgba(78, 63, 55, 0.12);
}

.pastel-lavender { background: linear-gradient(180deg, rgba(227, 220, 255, 0.55), rgba(255,255,255,0.72)); }
.pastel-blue { background: linear-gradient(180deg, rgba(223, 238, 252, 0.6), rgba(255,255,255,0.72)); }
.pastel-peach { background: linear-gradient(180deg, rgba(249, 221, 209, 0.62), rgba(255,255,255,0.72)); }
.pastel-green { background: linear-gradient(180deg, rgba(221, 241, 221, 0.6), rgba(255,255,255,0.72)); }
.pastel-pink { background: linear-gradient(180deg, rgba(248, 223, 232, 0.62), rgba(255,255,255,0.72)); }

.task-tag {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 5px 10px;
  border-radius: 9999px;
  border: 1px solid rgba(74, 62, 58, 0.14);
  background: rgba(255, 255, 255, 0.52);
  font-size: 10px;
  font-weight: 700;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: var(--ink);
}

.note-card {
  border-radius: 24px;
  border: 2px solid rgba(89, 72, 62, 0.18);
  background: rgba(255,255,255,0.62);
  box-shadow: 0 8px 18px rgba(91, 73, 62, 0.06);
}

.ink-button {
  border-radius: 16px;
  border: 2px solid rgba(82, 69, 63, 0.14);
  background: rgba(255,255,255,0.58);
  color: var(--ink);
  box-shadow: 0 4px 0 rgba(98, 77, 69, 0.08);
}

.ink-button.primary {
  background: linear-gradient(180deg, #f3d9ae, #f6c9a6);
  border-color: rgba(134, 97, 67, 0.2);
}

.ink-button.soft {
  background: linear-gradient(180deg, rgba(227,220,255,0.9), rgba(255,255,255,0.7));
}

.ink-button.coral {
  background: linear-gradient(180deg, rgba(247, 201, 191, 0.95), rgba(255,255,255,0.7));
}

.ink-button.green {
  background: linear-gradient(180deg, rgba(221, 241, 221, 0.95), rgba(255,255,255,0.72));
}

.dot-badge {
  width: 10px;
  height: 10px;
  border-radius: 50%;
  background: currentColor;
  display: inline-block;
}

.public-shell {
  min-height: 100vh;
  background:
    radial-gradient(circle at top left, rgba(249, 223, 232, 0.3), transparent 20%),
    radial-gradient(circle at bottom right, rgba(223, 238, 252, 0.25), transparent 25%),
    linear-gradient(180deg, var(--background) 0%, var(--paper) 100%);
  color: var(--ink);
}

.public-card {
  background: var(--public-card);
  border: 1px solid var(--public-border);
  border-radius: 24px;
  box-shadow: 0 12px 30px var(--shadow);
}

.public-link {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  border-radius: 9999px;
  border: 1px solid var(--public-border);
  background: rgba(255,255,255,0.4);
  color: var(--ink);
  padding: 0.72rem 1rem;
  font-size: 0.82rem;
  font-weight: 700;
}

.public-hero {
  background: linear-gradient(135deg, rgba(227, 220, 255, 0.4), rgba(223, 238, 252, 0.3), rgba(248, 223, 232, 0.35));
  border: 1px solid var(--public-border);
  border-radius: 30px;
}

html[data-theme="dark"] .public-hero {
  background: linear-gradient(135deg, rgba(95, 79, 120, 0.42), rgba(30, 55, 74, 0.38), rgba(77, 56, 52, 0.34));
}

.line-clamp-2 {
  display: -webkit-box;
  -webkit-line-clamp: 2;
  line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

@media (max-width: 768px) {
  .paper-card,
  .sticky-note,
  .note-card {
    border-radius: 20px;
  }
}
