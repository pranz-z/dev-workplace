+  .notebook-workspace .notebook-dense select { max-width: 100%; }
+}
+@media (prefers-reduced-motion: reduce) {
+  .notebook-typing :is(.notebook-typing-pencil,.notebook-typing-line) { animation: none; transform: none; stroke-dashoffset: 0; }
+  .notebook-workspace :is(.notebook-dense,.workspace-dialog,.workspace-ai-panel) *, .public-ai-concierge * { transition: none; scroll-behavior: auto; }
+}
