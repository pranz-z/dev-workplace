+.public-ai-concierge > section { background: var(--nb-bg); color: var(--nb-ink); border: 1.5px solid var(--nb-muted); border-radius: var(--nb-card-radius); }
+.public-ai-concierge textarea { color: var(--nb-ink); background: var(--nb-bg); border-color: var(--nb-muted); }
+.public-ai-concierge button[type="submit"] { background: var(--nb-accent-text); color: var(--nb-button-ink); }
+.notebook-typing { display: flex; align-items: center; gap: .35rem; color: var(--nb-muted); }
+.notebook-typing svg { flex-shrink: 0; fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; }
+.notebook-typing-pencil { animation: notebook-writing 1.2s ease-in-out infinite; transform-origin: 16px 12px; }
+.notebook-typing-line { stroke-dasharray: 24; animation: notebook-writing-line 1.2s ease-in-out infinite; }
+@keyframes notebook-writing { 50% { transform: translateX(3px) rotate(-8deg); } }
+@keyframes notebook-writing-line { 0%,100% { stroke-dashoffset: 18; } 50% { stroke-dashoffset: 0; } }
+@media (max-width: 639px) {
+  .notebook-workspace .notebook-dense > .flex { flex-wrap: wrap; }
