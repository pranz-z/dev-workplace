# Browser-safe Supabase configuration. Required for authenticated and public data.
# Find both values in Supabase → Project Settings → API. Never put server keys here.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional locally; set to the HTTPS production origin for canonical URLs and OAuth.
# Vercel previews resolve from VERCEL_URL; production custom domains should set this.
NEXT_PUBLIC_SITE_URL=

# GitHub App repository access (server-side only). Create the App with the
# Phase 3A/3B read-only repository permissions documented in README.md, plus the
# setup URL and OAuth callback below. Keep credentials out of NEXT_PUBLIC_* and source control.
# http://localhost:3000/api/github/setup
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM private key; preserve newlines or use literal \n sequences.
GITHUB_APP_PRIVATE_KEY=

# Server-only Supabase key used only after GitHub confirms this user can access
# the selected installation. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Gemini workspace assistant (server-side only). Create credentials in Google AI Studio.
# Use a stable Gemini API model ID supported by the project, such as gemini-3.8-flash.
GEMINI_API_KEY=
GEMINI_MODEL=

# Public portfolio AI (server-side only). Keep the HMAC salt secret and at
# least 32 characters; default Gemini-backed public requests are capped at 25/day.
# Required only when the public AI assistant is enabled.
PUBLIC_AI_RATE_LIMIT_SALT=
PUBLIC_AI_DAILY_LIMIT=25

# Private workspace AI rate limits (server-only configuration; defaults shown).
# Counters store only the authenticated user ID and request totals, never prompts.
PRIVATE_AI_REQUESTS_PER_MINUTE=10
PRIVATE_AI_DAILY_LIMIT=100

