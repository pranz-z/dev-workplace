# Supabase public configuration — copy this file to .env.local and fill in real values.
# Both values live in the Supabase dashboard: Project Settings → API.
# .env.local is gitignored; never commit real project values.

NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional: canonical site origin used to build the GitHub OAuth redirect URL.
# Leave empty to use the current browser origin (http://localhost:3000 in development).
NEXT_PUBLIC_SITE_URL=

# GitHub App repository access (server-side only). Create the App with the
# Phase 3A/3B read-only repository permissions documented in README.md, plus the
# setup URL and OAuth callback below. Keep credentials out of NEXT_PUBLIC_* and source control.
# http://localhost:3000/api/github/setup
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Paste the PEM private key; preserve newlines or use literal \n sequences.
GITHUB_APP_PRIVATE_KEY=

# Server-only Supabase key used only after GitHub confirms this user can access
# the selected installation. Never expose this key to browser code.
SUPABASE_SERVICE_ROLE_KEY=

